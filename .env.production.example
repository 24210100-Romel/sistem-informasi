# ===== Template .env untuk PRODUKSI (PHP 8.4.1+) =====
# Salin ke .env di server, lalu isi semua nilai bertanda <...>.

APP_NAME="DISKOMINFO Kota Manado"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://contoh-domain.go.id   # GANTI dengan domain asli (wajib https)
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<nama_database>
DB_USERNAME=<user_database>
DB_PASSWORD=<password_database>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Password admin awal (dipakai saat `php artisan db:seed` pertama kali). Kosong = dibuat acak & ditampilkan di layar.
ADMIN_PASSWORD=

# Isi * bila situs di belakang Cloudflare/proxy/load balancer.
TRUSTED_PROXIES=

# Rahasia token REST API (kosong = memakai APP_KEY). Isi string acak panjang.
API_TOKEN_SECRET=
API_TOKEN_TTL=86400

# Asisten AI. Kosong = mode pencarian konten (gratis). Isi untuk jawaban Claude.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_PER_MINUTE=8
AI_PER_DAY=60
